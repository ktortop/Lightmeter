// CONSTANTS
// ─────────────────────────────────────────────
const float fc_conversion      = 10.76391f;   // lux -> foot-candles
const float logTriggerDistance = 1.60f;       // ~5.25 ft between log points
const float levelTolerance     = 5.0f;        // degrees
const int   MIN_SATS           = 4;

// ***** NO-SD CHANGE ***** how often the LCD lux reading refreshes
const unsigned long LUX_UPDATE_MS = 500;
const unsigned long LUX_RETRY_MS  = 5000;     // retry a missing sensor this often

// LED pins
const int gps_red   = 2;
const int gps_green = 3;
const int lux_red   = 5;
const int lux_green = 6;
const int imu_red   = 8;
const int imu_green = 9;

// Buttons
const int BTN_SLEEP      = 10;
const int BTN_LOG_TOGGLE = 11;   // now turns Serial CSV output on/off
const int BTN_FORCE_LOG  = 12;   // prints a CSV line right now

bool isSleeping     = false;
bool loggingEnabled = true;
bool forceLog       = false;

unsigned long lastBtnSleepTime = 0;
unsigned long lastBtnLogTime   = 0;
unsigned long lastBtnForceTime = 0;
const unsigned long debounceDelay = 250;

// GPS speed conversion
const float KNOTS_TO_MPS = 0.514444f;
const float MIN_GPS_VEL_FUSE_MPS = 0.80f;

// GPS measurement noise
const float R_GPS_POS = 4.0f;   // m^2
const float R_GPS_VEL = 1.0f;   // (m/s)^2

// Process noise heuristics
const float Q_POS = 0.05f;
const float Q_VEL = 0.20f;

unsigned long lastIMUTime        = 0;
unsigned long lastGoodGPSFixTime = 0;
unsigned long gpsSetupTime       = 0;
unsigned long lastFixTime        = 0;

// ***** NO-SD CHANGE ***** latest light reading, shared by LCD + Serial
bool          luxOk         = false;
bool          luxValid      = false;   // false if saturated / not read yet
float         lastLux       = 0.0f;
float         lastFc        = 0.0f;
unsigned long lastLuxRead   = 0;
unsigned long lastLuxRetry  = 0;

// ***** SATURATION FIX *****
// At 100 ms integration the sensor's counts top out at 36863 (NOT 65535).
// In bright light both channels hit that ceiling, and the library's formula
// (full - ir) * (1 - ir/full) then gives ~0 -> the stuck "0.1 lux".
// Now saturated readings are detected, and the gain steps down/up
// automatically so the reading stays in range.
// ***** FIXED GAIN ***** gain stays at LOW (1x) all the time.
// Set this to true to turn automatic gain switching back on.
const bool AUTO_GAIN = false;

const uint16_t TSL_MAX_COUNT  = 36863;
const uint16_t TSL_HIGH_LIMIT = 33000;   // ~90% of max: too bright, lower gain
const uint16_t TSL_LOW_LIMIT  = 200;     // too dark, raise gain

const tsl2591Gain_t GAIN_STEPS[] = { TSL2591_GAIN_LOW, TSL2591_GAIN_MED, TSL2591_GAIN_HIGH };
const char*         GAIN_NAMES[] = { "1x", "25x", "428x" };
uint8_t  gainIndex = 0;          // starts at LOW (set in configureSensor)
uint16_t lastFull  = 0;          // raw counts, shown for troubleshooting
uint16_t lastIr    = 0;

// ─────────────────────────────────────────────
// SENSOR OBJECTS
// ─────────────────────────────────────────────
LiquidCrystal_I2C lcd(0x27, 20, 4);
Adafruit_TSL2591  tsl = Adafruit_TSL2591(2591);
Adafruit_GPS      GPS(&Serial1);

// ***** NO-SD CHANGE ***** background GPS reader. Reading the light sensor
// blocks for ~110 ms, which is long enough for GPS data to overflow the
// Serial1 buffer. This timer interrupt (~1 kHz) keeps draining Serial1.
// It is switched on at the END of setup(), after the I2C devices start.
ISR(TIMER0_COMPA_vect) {
  while (Serial1.available()) GPS.read();
}


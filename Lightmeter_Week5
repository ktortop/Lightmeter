// ─────────────────────────────────────────────
// LED HELPER — RED / YELLOW / GREEN / OFF
// FIX: YELLOW and OFF were swapped. YELLOW = both on, OFF = both off.
// ─────────────────────────────────────────────
void setLED(int r, int g, const char* color) {
  if      (strcmp(color, "GREEN")  == 0) { digitalWrite(r, LOW);  digitalWrite(g, HIGH); }
  else if (strcmp(color, "RED")    == 0) { digitalWrite(r, HIGH); digitalWrite(g, LOW);  }
  else if (strcmp(color, "YELLOW") == 0) { digitalWrite(r, HIGH); digitalWrite(g, HIGH); }
  else                                   { digitalWrite(r, LOW);  digitalWrite(g, LOW);  }
}

float distanceMeters(float x1, float y1, float x2, float y2) {
  float dx = x2 - x1;
  float dy = y2 - y1;
  return sqrt(dx * dx + dy * dy);
}

// ─────────────────────────────────────────────
// BNO055 UART HELPERS
// FIX: error responses (0xEE xx, e.g. bus over-run) are now detected right
// away instead of stalling 100 ms waiting for bytes that never come, and
// reads/writes are retried because BNO055 UART errors are common.
// ─────────────────────────────────────────────
bool bnoReadOnce(uint8_t reg, uint8_t len, uint8_t* buf) {
  while (Serial2.available()) Serial2.read();

  Serial2.write(0xAA);
  Serial2.write(0x01);
  Serial2.write(reg);
  Serial2.write(len);

  unsigned long t = millis();
  while (Serial2.available() < 2) {
    if (millis() - t > 100) return false;
  }

  uint8_t hdr = Serial2.read();
  uint8_t cnt = Serial2.read();
  if (hdr == 0xEE) return false;               // error/status response
  if (hdr != 0xBB || cnt != len) return false;

  while (Serial2.available() < len) {
    if (millis() - t > 100) return false;
  }
  for (int i = 0; i < len; i++) buf[i] = Serial2.read();
  return true;
}

bool bnoRead(uint8_t reg, uint8_t len, uint8_t* buf) {
  for (int attempt = 0; attempt < 3; attempt++) {
    if (bnoReadOnce(reg, len, buf)) return true;
    delay(2);
  }
  return false;
}

bool bnoWriteOnce(uint8_t reg, uint8_t val) {
  while (Serial2.available()) Serial2.read();

  Serial2.write(0xAA);
  Serial2.write(0x00);
  Serial2.write(reg);
  Serial2.write(0x01);
  Serial2.write(val);

  unsigned long t = millis();
  while (Serial2.available() < 2) {
    if (millis() - t > 100) return false;
  }

  uint8_t hdr    = Serial2.read();
  uint8_t status = Serial2.read();
  return (hdr == 0xEE && status == 0x01);
}

bool bnoWrite(uint8_t reg, uint8_t val) {
  for (int attempt = 0; attempt < 3; attempt++) {
    if (bnoWriteOnce(reg, val)) return true;
    delay(5);
  }
  return false;
}

bool bnoReadVector(uint8_t reg, float scale, float& x, float& y, float& z) {
  uint8_t buf[6];
  if (!bnoRead(reg, 6, buf)) return false;

  x = (int16_t)(buf[0] | (buf[1] << 8)) / scale;
  y = (int16_t)(buf[2] | (buf[3] << 8)) / scale;
  z = (int16_t)(buf[4] | (buf[5] << 8)) / scale;
  return true;
}

// ─────────────────────────────────────────────
// IMU INIT
// FIX: write results are now checked. Previously a silently failed write
// to OPR_MODE could leave the chip in CONFIG mode, where every fusion
// register (Euler, linear accel) reads 0 while the code reports PASS.
// ─────────────────────────────────────────────
bool bnoBegin() {
  Serial2.begin(115200);
  delay(1000);

  uint8_t id = 0;
  bool found = false;
  for (int i = 0; i < 5 && !found; i++) {
    if (bnoRead(BNO_REG_CHIP_ID, 1, &id) && id == BNO_CHIP_ID) found = true;
    else delay(200);
  }
  if (!found) return false;

  if (!bnoWrite(BNO_REG_OPR_MODE, BNO_OPR_MODE_CONFIG)) return false; delay(30);
  bnoWrite(BNO_REG_PAGE_ID, 0x00);                                  delay(10);
  if (!bnoWrite(BNO_REG_PWR_MODE, BNO_PWR_MODE_NORMAL)) return false; delay(10);
  bnoWrite(BNO_REG_SYS_TRIGGER, 0x80);  /* use external crystal */  delay(10);
  if (!bnoWrite(BNO_REG_OPR_MODE, BNO_OPR_MODE_NDOF)) return false;  delay(50);

  // Confirm the mode actually changed
  uint8_t mode = 0;
  if (!bnoRead(BNO_REG_OPR_MODE, 1, &mode)) return false;
  return (mode & 0x0F) == BNO_OPR_MODE_NDOF;
}


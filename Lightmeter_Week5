// ─────────────────────────────────────────────
// GPS BACKGROUND READER
// Timer0 compare interrupt fires ~every 1 ms and drains Serial1 into the
// GPS parser. Without this, the 64-byte Serial1 buffer overflows during
// blocking calls (light sensor ~120 ms, SD writes, LCD, BNO timeouts) and
// NMEA sentences get corrupted.
// ─────────────────────────────────────────────
ISR(TIMER0_COMPA_vect) {
  while (Serial1.available()) GPS.read();
}


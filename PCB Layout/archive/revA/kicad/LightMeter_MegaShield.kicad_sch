  (text "EVEI LIGHT METER - Arduino Mega 2560 carrier shield"
    (exclude_from_sim no)
    (at 20 20 0)
    (effects
      (font
        (size 3.5 3.5)
      )
      (justify left bottom)
    )
    (uuid "1986b73e-283b-411b-ba3f-310f129b91ca")
  )
  (text "Pin map from latest_version_of_lightmeter.ino: SD CS=D53 (HW SPI 50/51/52), GPS=Serial1 (D18/D19), IMU=Serial2 (D16/D17), I2C=D20/D21,\nLEDs common-anode to 5V (active LOW): GPS D2/D3, LUX D5/D6, IMU D8/D9; buttons to GND with INPUT_PULLUP: sleep D10, log toggle D11, force log D12."
    (exclude_from_sim no)
    (at 20 28 0)
    (effects
      (font
        (size 1.5 1.5)
      )
      (justify left bottom)
    )
    (uuid "c201708c-916c-4525-aa76-df4336010a85")
  )
  (text "microSD: on-board socket, 3.3V LDO, 74LVC125 shifts MOSI/SCK/CS 5V->3.3V; MISO (3.3V) goes straight to D50 (same as Adafruit 254 breakout)."
    (exclude_from_sim no)
    (at 130 20 0)
    (effects
      (font
        (size 1.5 1.5)
      )
      (justify left bottom)
    )
    (uuid "470d4916-6264-4bec-8ad6-040c97c31956")
  )
  (text "IMU in UART mode: PS1 tied to breakout 3Vo via JP1. BNO SDA pin = UART TX -> Mega RX2 (D17); BNO SCL pin = UART RX -> Mega TX2 (D16)."
    (exclude_from_sim no)
    (at 130 165 0)
    (effects
      (font
        (size 1.5 1.5)
      )
      (justify left bottom)
    )
    (uuid "5e15de88-a42e-42c9-b228-ea0054000851")
  )
  (text "Connector pinouts (JST-XH): LCD/LUX = GND,5V,SDA,SCL   LEDx = 5V(common anode),RED,GREEN   BTNx = GND,SW,5V(lamp)"
    (exclude_from_sim no)
    (at 300 35 0)
    (effects
      (font
        (size 1.5 1.5)
      )
      (justify left bottom)
    )
    (uuid "dc2a27ea-a5d6-418f-af5b-74ecaf966d18")
  )
